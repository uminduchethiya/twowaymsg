APP_NAME=MessageApp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-APP.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

# ── Laravel Reverb ────────────────────────────────────────────────────────────
# REVERB_HOST should be the public domain of your Reverb Railway service
# e.g.  reverb-production-xxxx.up.railway.app
REVERB_APP_ID=messageapp
REVERB_APP_KEY=messageapp-key
REVERB_APP_SECRET=messageapp-secret
REVERB_HOST=YOUR-REVERB-SERVICE.up.railway.app
REVERB_PORT=443
REVERB_SCHEME=https

# Passed to Vite at build time — must match the public Reverb URL
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
